 local isRunning = false -- Variable to track the loop state

local Toggle = MainTab:CreateToggle({
    Name = "Auto Quest",
    CurrentValue = false,
    Flag = "Toggle1",
    Callback = function(Value)
        isRunning = Value -- Update the loop state based on the toggle value

        if isRunning then
            while isRunning do
                local Event = game:GetService("ReplicatedStorage").Remotes.Quests.DoQuest
                Event:InvokeServer("calamityOfNoctharis")
                wait()
            end
        end
    end,
})
local Toggle = MainTab:CreateToggle({
    Name = "Auto Purchase Potion (Energy)",
    CurrentValue = false,
    Flag = "Toggle2",
    Callback = function(Value)
        isRunning = Value -- Update the loop state based on the toggle value

        if isRunning then
            while isRunning do
                for i = 1, 20 do
                local Event = game:GetService("ReplicatedStorage").Remotes.Shop.BuyShopItem
                Event:InvokeServer( "minorEnergyPotion")
                end

                task.wait(0.1)

                for i = 1, 10 do
                local Event = game:GetService("ReplicatedStorage").Remotes.Shop.BuyShopItem
                Event:InvokeServer("greaterEnergyPotion")
                end

                task.wait(0.1)

                for i = 1, 5 do
                local Event = game:GetService("ReplicatedStorage").Remotes.Shop.BuyShopItem
                Event:InvokeServer("grandEnergyPotion")
                end

                wait ()
            end
        end
    end,
})





